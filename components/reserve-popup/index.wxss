.reserve-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reserve-popup-container {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.reserve-popup-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 40rpx 0 20rpx;
}

.reserve-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.reserve-popup-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reserve-popup-content {
  padding: 20rpx 40rpx 30rpx;
  text-align: center;
}

.reserve-popup-text {
  font-size: 30rpx;
  color: #666;
  word-break: break-all;
}

.reserve-popup-btn-wrap {
  padding: 0 40rpx 40rpx;
}

.reserve-popup-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}

.reserve-popup-btn::after {
  border: none;
}
