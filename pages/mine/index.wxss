.mine-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
}

.mine-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.mine-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.mine-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mine-avatar-placeholder-icon {
  font-size: 48rpx;
  color: #999;
}

.mine-user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.mine-nickname-row {
  display: flex;
  align-items: center;
}

.mine-nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.mine-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #999;
  border-bottom: 3rpx solid #999;
  transform: rotate(-45deg);
  margin-left: 12rpx;
}

.mine-id-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.mine-id-text {
  font-size: 22rpx;
  color: #576b95;
  word-break: break-all;
  max-width: 360rpx;
  background: #f0f3f8;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.mine-copy-btn {
  background: linear-gradient(135deg, #576b95, #6e83b5);
  padding: 4rpx 14rpx;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(87, 107, 149, 0.35);
}

.mine-copy-btn-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.mine-id-loading {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 登录弹窗 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-box {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 36rpx 0 16rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.dialog-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-close-text {
  font-size: 28rpx;
  color: #999;
}

.dialog-body {
  padding: 24rpx 40rpx;
}

.dialog-footer {
  padding: 16rpx 40rpx 36rpx;
}

.login-avatar-row {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.login-avatar-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  width: 120rpx;
  height: 120rpx;
  line-height: normal;
}

.login-avatar-btn::after {
  border: none;
}

.login-avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.login-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e5e5e5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.login-avatar-placeholder-icon {
  font-size: 36rpx;
  color: #999;
}

.login-avatar-placeholder-text {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

.login-nickname-row {
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  margin-bottom: 16rpx;
}

.login-label {
  font-size: 26rpx;
  color: #666;
  width: 100rpx;
  flex-shrink: 0;
}

.login-nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.login-phone-row {
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  background: #f9f9f9;
  margin-bottom: 16rpx;
  height: 80rpx;
}

.login-phone-btn {
  flex: 1;
  font-size: 26rpx;
  color: #576b95;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 80rpx;
  text-align: left;
}

.login-phone-btn::after {
  border: none;
}

.login-confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  color: #576b95;
  box-shadow: 0 4rpx 16rpx rgba(87, 107, 149, 0.2);
}
