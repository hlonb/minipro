page {
  background-color: #f5f5f5;
}

.home-page {
  padding: 0 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
}

/* 店铺信息 */
.shop-info {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.shop-info-left {
  margin-right: 20rpx;
}

.shop-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: #fff5f0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-info-right {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.shop-address {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.shop-address-text {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

/* 预约按钮 */
.reserve-btns {
  display: flex;
  margin-top: 16rpx;
  gap: 16rpx;
}

.reserve-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
}

.reserve-btn-wechat {
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

.reserve-btn-phone {
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(250, 65, 38, 0.2);
}

.reserve-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.reserve-btn-wechat .reserve-btn-text {
  color: #07c160;
}

.reserve-btn-phone .reserve-btn-text {
  color: #fa4126;
}

/* DM模块 */
.dm-section {
  margin-top: 24rpx;
}

.section-header {
  padding: 16rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.dm-scroll {
  width: 100%;
  white-space: nowrap;
}

.dm-list {
  display: inline-flex;
  padding: 0 4rpx;
}

.dm-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}

.dm-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.dm-name {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  white-space: nowrap;
}

/* 剧本推荐 */
.script-section {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.script-detail {
  margin-top: 12rpx;
}

.script-detail-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.script-detail-tags {
  display: flex;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.script-tag {
  font-size: 22rpx;
  color: #fa4126;
  background: #fff5f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.script-detail-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
  display: block;
}

.script-detail-price {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.script-price-symbol {
  font-size: 28rpx;
  color: #fa4126;
  font-weight: 600;
}

.script-price-num {
  font-size: 40rpx;
  color: #fa4126;
  font-weight: 600;
}

.script-price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

/* 剧本图片列表 */
.script-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 20rpx;
}

.script-image-list {
  display: inline-flex;
}

.script-image-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
  position: relative;
}

.script-image-active {
  transform: scale(1);
}

.script-image-active .script-image {
  border: 4rpx solid #fa4126;
}

.script-image-active .script-image-name {
  color: #fa4126;
  font-weight: 600;
}

.script-image {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
}

.script-image-name {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  white-space: nowrap;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
