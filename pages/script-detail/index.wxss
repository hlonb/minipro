page {
  background-color: #f5f5f5;
}

.detail-page {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.detail-header {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.detail-cover {
  width: 240rpx;
  height: 320rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.detail-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.detail-tags {
  display: flex;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.detail-tag {
  font-size: 22rpx;
  color: #fa4126;
  background: #fff5f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.detail-roles {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.detail-role-item {
  font-size: 24rpx;
  color: #666;
}

.detail-role-divider {
  font-size: 24rpx;
  color: #ccc;
  margin: 0 12rpx;
}

.detail-price {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.detail-price-symbol {
  font-size: 28rpx;
  color: #fa4126;
  font-weight: 600;
}

.detail-price-num {
  font-size: 44rpx;
  color: #fa4126;
  font-weight: 600;
}

.detail-price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.detail-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.detail-images {
  display: flex;
  flex-direction: column;
}

.detail-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.loading-wrap {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
