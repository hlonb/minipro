.scripts-page {
  padding: 0 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  background: #f5f5f5;
  min-height: 100vh;
}

/* 篩選區 */
.filter-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.filter-group {
  margin-bottom: 12rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
  display: block;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-options {
  display: inline-flex;
  gap: 12rpx;
}

.filter-option {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  white-space: nowrap;
}

.filter-option-active {
  color: #fff;
  background: #fa4126;
}

/* 结果列表 */
.result-list {
  margin-top: 16rpx;
}

.result-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.result-image {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.result-meta {
  display: flex;
  margin-top: 8rpx;
  gap: 8rpx;
}

.result-meta-item {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.result-tags {
  display: flex;
  margin-top: 8rpx;
  flex-wrap: wrap;
  gap: 6rpx;
}

.result-tag {
  font-size: 20rpx;
  color: #fa4126;
  background: #fff5f0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.result-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.result-price {
  font-size: 28rpx;
  color: #fa4126;
  font-weight: 600;
}

.result-type-badge {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ee;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.result-empty {
  padding: 80rpx 0;
  text-align: center;
}

.result-empty-text {
  font-size: 26rpx;
  color: #999;
}
