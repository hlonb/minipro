.manage-page {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  min-height: 100vh;
  background: #f5f5f5;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-active {
  color: #fa4126;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #fa4126;
  border-radius: 3rpx;
}

/* 添加按钮 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: #fff;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(250, 65, 38, 0.2);
}

.add-btn-script {
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

.add-btn-admin {
  box-shadow: 0 4rpx 16rpx rgba(87, 107, 149, 0.2);
}

.add-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.add-btn-text-red {
  color: #fa4126;
}

.add-btn-text-green {
  color: #07c160;
}

.add-btn-text-blue {
  color: #576b95;
}

/* 列表 */
.item-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.item-card:last-child {
  border-bottom: none;
}

.item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  margin-left: 20rpx;
}

.item-name-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.gender-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.gender-icon-male {
  background: #4a90d9;
}

.gender-icon-female {
  background: #f5a0b0;
}

.gender-icon-text {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

.gender-option-male.select-option-active {
  background: #4a90d9;
}

.gender-option-female.select-option-active {
  background: #f5a0b0;
}

.item-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 剧本卡片 */
.script-card {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.script-card:last-child {
  border-bottom: none;
}

.script-card-image {
  width: 100rpx;
  height: 140rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.script-card-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.script-card-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.script-card-meta {
  display: flex;
  margin-top: 6rpx;
  gap: 6rpx;
}

.script-card-meta-item {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.script-card-tags {
  display: flex;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.script-card-tag {
  font-size: 20rpx;
  color: #fa4126;
  background: #fff5f0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}

.script-card-price {
  font-size: 26rpx;
  color: #fa4126;
  font-weight: 600;
  margin-top: 8rpx;
}

.empty-tip {
  padding: 60rpx 0;
  text-align: center;
}

.empty-tip-text {
  font-size: 26rpx;
  color: #999;
}

.loading-wrap {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 弹窗通用 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-box {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.dialog-box-wide {
  width: 660rpx;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 36rpx 0 16rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.dialog-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-body {
  padding: 24rpx 40rpx;
}

.dialog-body-scroll {
  max-height: 700rpx;
}

.dialog-footer {
  padding: 16rpx 40rpx 36rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

/* 头像上传 */
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx dashed #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-text {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 4rpx;
}

/* 剧本封面上传 */
.script-image-upload {
  width: 200rpx;
  height: 280rpx;
  margin: 0 auto 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx dashed #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.script-image-preview {
  width: 200rpx;
  height: 280rpx;
}

.script-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.script-image-placeholder-text {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 4rpx;
}

/* 输入框 */
.input-wrap {
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  margin-bottom: 12rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
  width: 140rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.textarea-field {
  min-height: 80rpx;
  line-height: 1.5;
}

/* 选择器组 */
.select-group {
  margin-bottom: 12rpx;
}

.select-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.select-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.select-option {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.select-option-active {
  color: #fff;
  background: #fa4126;
}

.shop-edit-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
}

.shop-info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.shop-info-row-last {
  border-bottom: none;
}

.shop-info-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.shop-info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.edit-shop-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: #fff;
  border-radius: 40rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(250, 65, 38, 0.2);
}

.edit-shop-btn-text {
  color: #fa4126;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.confirm-btn-green {
  color: #07c160;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

.confirm-btn-red {
  color: #fa4126;
  box-shadow: 0 4rpx 16rpx rgba(250, 65, 38, 0.2);
}

.confirm-btn-primary {
  background-color: #fa4126;
}

.confirm-btn-disabled {
  opacity: 0.6;
}

.detail-images-section {
  margin-bottom: 12rpx;
}

.detail-images-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-images-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.detail-images-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.detail-images-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
}

.detail-images-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.player-input-group {
  margin-bottom: 12rpx;
}

.player-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.player-input-item {
  flex: 0;
  width: auto;
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  background: #f9f9f9;
}

.player-input-field {
  width: 80rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.player-input-unit {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

/* 管理员管理 */
.admin-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.admin-card:last-child {
  border-bottom: none;
}

.admin-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.admin-openid {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.admin-label {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.admin-label-self {
  color: #576b95;
  background: #f0f3f8;
}

.admin-tip {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.admin-tip-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.confirm-btn-blue {
  color: #576b95;
  box-shadow: 0 4rpx 16rpx rgba(87, 107, 149, 0.2);
}
