.settings-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.settings-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.settings-item-last {
  border-bottom: none;
}

.settings-label {
  font-size: 28rpx;
  color: #333;
  width: 140rpx;
  flex-shrink: 0;
}

.settings-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.settings-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.settings-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-avatar-placeholder-text {
  font-size: 20rpx;
  color: #999;
}

.settings-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #999;
  border-bottom: 3rpx solid #999;
  transform: rotate(-45deg);
  margin-left: 12rpx;
}

.settings-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.settings-phone {
  font-size: 28rpx;
  color: #999;
}

.settings-phone-btn {
  font-size: 24rpx;
  color: #576b95;
  background: none;
  border: none;
  padding: 0;
  margin-left: 16rpx;
  line-height: 1;
}

.settings-phone-btn::after {
  border: none;
}

.settings-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(87, 107, 149, 0.2);
}

.settings-save-btn-text {
  font-size: 28rpx;
  color: #576b95;
  font-weight: 500;
}
