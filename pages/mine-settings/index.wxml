<view class="settings-page">
  <view class="settings-section">
    <view class="settings-item" catch:tap="onChooseAvatar">
      <text class="settings-label">头像</text>
      <view class="settings-right">
        <image class="settings-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <view class="settings-avatar-placeholder" wx:else>
          <text class="settings-avatar-placeholder-text">点击设置</text>
        </view>
        <view class="settings-arrow"></view>
      </view>
    </view>
    <view class="settings-item">
      <text class="settings-label">昵称</text>
      <view class="settings-right">
        <input class="settings-input" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNicknameInput" bindconfirm="onNicknameConfirm" />
      </view>
    </view>
    <view class="settings-item settings-item-last">
      <text class="settings-label">手机号</text>
      <view class="settings-right">
        <text class="settings-phone">{{phone || '未绑定'}}</text>
        <button class="settings-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">绑定</button>
      </view>
    </view>
  </view>
  <view class="settings-save-btn" bind:tap="onSave">
    <text class="settings-save-btn-text">保存</text>
  </view>
</view>
